doc = App.activeDocument()
if not doc:
    doc = App.newDocument("Unnamed")

App.ActiveDocument.addObject('PartDesign::Body','Body')
App.ActiveDocument.getObject('Body').Label = 'Body'
App.ActiveDocument.getObject('Body').AllowCompound = True
body = App.ActiveDocument.getObject('Body')

doc.recompute()

# 4. Output geometry straight to document tree
moravian_star = doc.addObject("Part::FeaturePython", "MoravianStarBody")
# .addObject(moravian_star)
MoravianStar(moravian_star)
        
if App.GuiUp:
    ViewProviderBox(moravian_star.ViewObject)

doc.recompute()
